{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",

    "strict": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "rootDir": ".",
    "outDir": "dist"
  },

  "include": [
    "src/**/*.ts",
    "demo.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}